# Bikontrol frontend (Angular 22) — build stage
# Node 24: Angular 22 CLI requires Node >=22.22.3 / >=24.15.0.
FROM node:24-alpine AS build
ARG API_URL=https://bikontrol.santidev21.tech/api
WORKDIR /src

COPY bikontrol-web/package.json bikontrol-web/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY bikontrol-web/ ./

# La API URL se fija ANTES del build. Reescribir los .js ya hasheados después
# (como se hacía antes) invalida los hashes de integridad de ngsw.json y rompe
# la verificación del service worker.
RUN sed -i "s|apiUrl: '[^']*'|apiUrl: '${API_URL}'|" src/environments/environment.prod.ts
RUN npm run build

# Serve stage — unprivileged nginx (runs as non-root nginx user, listens on 8080)
FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/dist/bikontrol-web/browser /usr/share/nginx/html

EXPOSE 8080
