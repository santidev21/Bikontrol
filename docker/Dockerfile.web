# Bikontrol frontend (Angular 22) — build stage
# Node 24: Angular 22 CLI requires Node >=22.22.3 / >=24.15.0.
FROM node:24-alpine AS build
# Public Google OAuth client id for "Sign in with Google". Baked into the bundle
# at build time (set-env.js reads GOOGLE_CLIENT_ID). Public value, no secret.
ARG GOOGLE_CLIENT_ID=
ENV GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}
# API base URL baked into the prod bundle. `prebuild` (set-env.js) reads API_URL,
# so the value must be set before `npm run build` (post-build rewrites of the
# hashed .js invalidate ngsw.json integrity and break the service worker).
ARG API_URL=https://bikontrol.santidev21.tech/api
ENV API_URL=${API_URL}
WORKDIR /src

COPY bikontrol-web/package.json bikontrol-web/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY bikontrol-web/ ./

# App version shown on the Profile screen. release-please owns version.txt at the
# repo root; set-env.js (prebuild) reads ../../version.txt, so place it at
# /version.txt inside the image.
COPY version.txt /version.txt

RUN npm run build

# Serve stage — unprivileged nginx (runs as non-root nginx user, listens on 8080)
FROM nginxinc/nginx-unprivileged:1.31-alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/dist/bikontrol-web/browser /usr/share/nginx/html

EXPOSE 8080
