# Bikontrol — Environment Variables Template
# Copy this file to '.env' and fill in the values before deploying.
# NEVER commit the real '.env'. Rotate secrets before going to production.

# ------------------------------------------------------------------
# Database (PostgreSQL)
# IMPORTANT: avoid '$' in the password (docker compose expands it).
# Values containing '#' or spaces must be wrapped in single quotes,
# e.g. POSTGRES_PASSWORD='MyPass#'
# ------------------------------------------------------------------
POSTGRES_DB=bikontrol_db
POSTGRES_USER=bikontrol
POSTGRES_PASSWORD=CHANGE_ME

# Connection string used by the .NET API.
# Host is 'bikontrol-db' (the DB container on the internal network).
# Keep the password identical to POSTGRES_PASSWORD.
ConnectionStrings__DefaultConnection=Host=bikontrol-db;Port=5432;Database=bikontrol_db;Username=bikontrol;Password=CHANGE_ME;SslMode=Require;Trust Server Certificate=true

# ------------------------------------------------------------------
# JWT
# Generate a strong key with: openssl rand -base64 48
# Access token lifetime in minutes (default 30).
# ------------------------------------------------------------------
Jwt__Key=CHANGE_ME
Jwt__Issuer=BikontrolAPI
Jwt__Audience=BikontrolClient
Jwt__ExpireMinutes=15

# Refresh token lifetime in days (default 30). Sessions renew the access
# token automatically via POST /api/auth/refresh.
Jwt__RefreshExpireDays=30

# ------------------------------------------------------------------
# Google OAuth (Sign in with Google / ID token flow)
# Client ID is public (also embedded in the Angular build). Only the
# ID-token flow is used, so NO Client Secret is required.
# ------------------------------------------------------------------
Google__ClientId=CHANGE_ME.apps.googleusercontent.com

# ------------------------------------------------------------------
# Frontend base URL (used to build the password-reset link)
# ------------------------------------------------------------------
Frontend__BaseUrl=https://bikontrol.santidev21.tech

# ------------------------------------------------------------------
# SMTP (password recovery email). Free options: Gmail SMTP with an App
# Password (smtp.gmail.com:587) or Resend (smtp.resend.com:465).
# ------------------------------------------------------------------
Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__Username=CHANGE_ME
Smtp__Password=CHANGE_ME
Smtp__FromEmail=CHANGE_ME@gmail.com
Smtp__FromName=Bikontrol
Smtp__EnableSsl=true

# ------------------------------------------------------------------
# CORS
# Comma-separated list of allowed browser origins. In production the
# frontend and API share the same origin (no CORS needed), but list the
# public origin here to be safe.
# ------------------------------------------------------------------
Cors__AllowedOrigins=https://bikontrol.santidev21.tech,http://localhost:4200,http://localhost:4201,http://127.0.0.1:4200,http://127.0.0.1:4201

# ------------------------------------------------------------------
# Reverse proxy / forwarded headers
# Comma-separated CIDRs the API trusts for X-Forwarded-For / X-Forwarded-Proto.
# Leave empty to default to private ranges (10/8, 172.16/12, 192.168/16, 127.0.0.1/32).
# Set this to the nginx gateway network if it is on a non-private range.
# ------------------------------------------------------------------
ReverseProxy__KnownNetworks=

# ------------------------------------------------------------------
# Public demo tenant (off by default).
# When false, POST /api/auth/demo returns 404 and no demo user/data is
# seeded. Enable only for a deliberate public/controlled demo:
#   Demo__Enabled=true
# ------------------------------------------------------------------
Demo__Enabled=false

# ------------------------------------------------------------------
# Email confirmation (default true).
# When true, registration sends a confirmation link and login is blocked
# until the email is confirmed. Set false to skip verification (e.g. a
# throwaway environment).
# ------------------------------------------------------------------
EmailConfirmation__Required=true

# ------------------------------------------------------------------
# Account lockout (anti brute force). After Lockout__MaxFailedAttempts
# consecutive failed logins the account is locked for Lockout__Minutes.
# Set Lockout__Enabled=false to disable (not recommended in production).
# ------------------------------------------------------------------
Lockout__Enabled=true
Lockout__MaxFailedAttempts=5
Lockout__Minutes=15

# ------------------------------------------------------------------
# Error tracking (Sentry). Leave DSN empty to disable (the API logs a
# warning-free no-op). Create a project at sentry.io and paste the DSN.
# TracesSampleRate: fraction of transactions traced (0.0–1.0).
# ------------------------------------------------------------------
Sentry__Dsn=
Sentry__TracesSampleRate=0.1

# ------------------------------------------------------------------
# Maintenance reminders (daily job). Enabled by default; the engine
# records due items and (in later steps) emails/pushes them. DedupeDays
# avoids repeating the same item too often.
# ------------------------------------------------------------------
Reminders__Enabled=true
Reminders__EmailEnabled=true
Reminders__DailyHourUtc=8
Reminders__DedupeDays=3
