<?xml version="1.0" encoding="utf-8" ?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura,opencover</Format>
          <Exclude>[*.Tests]*,[*.Tests.Integration]*</Exclude>
          <!--
            CompilerGeneratedAttribute is deliberately NOT excluded: coverlet then
            drops async state machines (MoveNext) of some classes entirely, so a
            fully tested async-only class such as DemoUserSeeder is reported as
            0% covered by Sonar.
          -->
          <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute</ExcludeByAttribute>
          <!--
            EF Core migration scaffolding is auto-generated and applied verbatim by
            the integration-test fixture, so coverlet reports it as ~100% covered
            and it dominates the denominator (it was ~87% of all coverable lines).
            Exclude only the generated Designer/snapshot files; migration Up/Down
            logic stays in scope. Mirrors sonar.coverage.exclusions in
            .github/workflows/sonarcloud.yml.
          -->
          <ExcludeByFile>**/Migrations/*.Designer.cs,**/Migrations/*ModelSnapshot.cs</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
